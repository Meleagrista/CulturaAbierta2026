:root {
}

.team-selector-button {
    width: 50%;
    height: 100%;
    background-color: rgba(188, 188, 188, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 2%;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-text-align: lower-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne.ttf?fileID=12800000&guid=6f2ddf5eaea5f994ab6f21341080f529&type=3#DarumadropOne");
    color: rgb(255, 255, 255);
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    font-size: 52px;
    letter-spacing: -5px;
    transition-duration: 0.2s;
    transition-property: color, background-color;
}

.team-selector-button:hover {
    color: rgb(220, 30, 30);
    background-color: rgba(0, 0, 0, 0.22);
}
