<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="screen overlay">
        <ui:VisualElement class="panel">
            <ui:Label text="Level complete!" class="title" />
            <ui:Label name="result-label" text="" class="subtitle" />
            <ui:Button name="next-button" text="Next level" class="menu-button" />
            <ui:Button name="retry-button" text="Retry" class="menu-button" />
            <ui:Button name="menu-button" text="Main menu" class="menu-button" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
