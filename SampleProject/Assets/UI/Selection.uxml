<ui:UXML xmlns:ui="UnityEngine.UIElements">
    <ui:VisualElement class="screen">
        <ui:Label text="Select level" class="title" />
        <ui:VisualElement class="row">
            <ui:Button name="left-button" text="&lt;" class="arrow-button" />
            <ui:Label name="level-label" text="Level 1 / 1" class="subtitle" />
            <ui:Button name="right-button" text="&gt;" class="arrow-button" />
        </ui:VisualElement>
        <ui:Button name="play-button" text="Play" class="menu-button" />
        <ui:Button name="back-button" text="Back" class="menu-button" />
    </ui:VisualElement>
</ui:UXML>
