:root {
}

.team-selector-button {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 50%;
    height: 100%;
    background-color: rgba(188, 188, 188, 0);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 2%;
    padding-left: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    -unity-text-align: lower-center;
    -unity-font-definition: url("project://database/Assets/UI/Fonts/DarumadropOne.ttf?fileID=12800000&guid=6f2ddf5eaea5f994ab6f21341080f529&type=3#DarumadropOne");
    color: rgb(165, 165, 165);
    -unity-text-outline-width: 2.5px;
    -unity-text-outline-color: rgb(0, 0, 0);
    font-size: 52px;
    letter-spacing: -5px;
    /* LuzPNG (the button's background image) is hidden by default and fades in on hover. */
    -unity-background-image-tint-color: rgba(255, 255, 255, 0);
    transition-duration: 0.2s;
    transition-property: color, -unity-background-image-tint-color;
}

.team-selector-button:hover {
    color: rgb(255, 255, 255);
    -unity-background-image-tint-color: rgba(255, 255, 255, 1);
}

#andalucia-half {
    left: 0;
}

#mancha-half {
    right: 0;
}

.team-selector-button Image {
    transform-origin: center bottom;
    transition-property: scale;
    transition-duration: 0.2s;
    transition-timing-function: ease-out-back;
}

.team-selector-button:hover Image {
    scale: 1.08 1.08;
}

/* La Mancha's button is mirrored (scale -1 on the button), so its image is flipped back here.
   Keep this in the USS, not inline: an inline scale would block the hover growth. */
#mancha-half Image {
    scale: -1 1;
}

#mancha-half:hover Image {
    scale: -1.08 1.08;
}
