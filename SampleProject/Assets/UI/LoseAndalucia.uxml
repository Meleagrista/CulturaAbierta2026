<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/WinLoseScreen.uss?fileID=7433441132597879392&amp;guid=3af08abaa59b8dc4291f8243e6891fbb&amp;type=3#WinLoseScreen"/>
    <ui:VisualElement class="screen overlay" style="width: 100%; height: 100%;">
        <ui:Image enabled="true" picking-mode="Ignore" name="Image" style="position: absolute; top: 10%; left: auto; right: auto; bottom: auto; align-self: center; width: 60%; height: 30%; -unity-background-scale-mode: scale-to-fit; background-image: url(&quot;project://database/Assets/UI/Sprites/DerrotaBannerPNG.png?fileID=2800000&amp;guid=820ba9dc7e68d474fa1758d920a892ea&amp;type=3#DerrotaBannerPNG&quot;); display: flex;"/>
        <ui:Image style="left: 0%; bottom: 0; right: auto; width: 100%; height: 30%; top: auto; background-image: url(&quot;project://database/Assets/UI/Sprites/BocadilloPNG.png?fileID=2800000&amp;guid=21f91c2442eaeaf4ca08640348c29f63&amp;type=3#BocadilloPNG&quot;); background-repeat: no-repeat no-repeat; background-position-y: center; -unity-slice-type: sliced; scale: 1 -1; -unity-background-scale-mode: scale-to-fit; background-size: contain; position: absolute;">
            <ui:Label name="message-label" text="Label" class="win-lose-label" style="bottom: 20%; top: auto; left: 35%; width: 40%; height: 50%; position: absolute; font-size: 32px; -unity-text-outline-width: 2px;"/>
        </ui:Image>
        <ui:Image class="tragantia"/>
        <ui:Button text="" name="retry-button" class="win-lose-button" style="background-color: rgba(188, 188, 188, 0); background-image: url(&quot;project://database/Assets/UI/Sprites/ReintentarPNG.png?fileID=2800000&amp;guid=f6536f8d8bde90f4d9ac003b3b73e2c8&amp;type=3#ReintentarPNG&quot;); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; padding-top: 0; padding-right: 0; padding-bottom: 0; padding-left: 0; width: 30%; height: 30%; top: 40%;"/>
        <ui:Button text="- Volver al inicio - " name="home-button" class="win-lose-back" style="font-size: 40px; -unity-text-outline-width: 4px;"/>
